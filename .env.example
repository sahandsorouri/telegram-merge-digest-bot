# From BotFather
BOT_TOKEN=your-telegram-bot-token

# Comma separated numeric Telegram user ids allowed to use the bot.
# Empty = the bot answers nobody.
ALLOWED_USER_IDS=

# IANA time zone for times and dates in the digest, for example Europe/London.
TZ=UTC

# Hours a delivered batch is kept before it is deleted. The format buttons
# under an old digest stop working once its batch is gone.
RETENTION_HOURS=24

# Hours an abandoned batch stays open before it expires.
STALE_BATCH_HOURS=168

# Seconds of quiet before the status line is re-posted at the bottom.
# This never closes a batch. Only the Done button does that.
STATUS_DEBOUNCE=1.2
